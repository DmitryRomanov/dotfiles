// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "edit_predictions": {
    "provider": "none",
  },
  "agent_servers": {
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
      "env": {},
    },
  },
  "current_line_highlight": "line",
  "show_whitespaces": "none",
  "tab_size": 2,
  "auto_indent_on_paste": false,
  "show_completions_on_input": true,
  "show_completion_documentation": false,
  "inline_code_actions": false,
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "breakpoints": true,
    "folds": true,
    "min_line_number_digits": 0,
  },
  "active_pane_modifiers": {
    "border_size": 0.5,
    "inactive_opacity": 1.0,
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": true,
    "git_status": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
    "outline_panel": {
      "default_width": 100,
      "indent_guides": {
        "show": "never",
      },
    },
    "file_finder": {
      "modal_max_width": "large",
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "theme": {
    "mode": "system",
    "light": "Tomorrow Min",
    "dark": "Gruvbox Dark",
  },
  "profiles": {
    "Laptop": {
      "settings": {
        "buffer_font_family": "Iosevka Nerd Font Mono",
        "ui_font_size": 18,
        "buffer_font_size": 21,
        "buffer_font_weight": 400,
        "buffer_line_height": "standard",
      },
    },
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "off",
  },
  "tab_bar": {
    "show": false,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
    // "experimental.show": false,
  },
  "line_indicator_format": "short",
  "debugger": {
    "dock": "left",
  },
  "relative_line_numbers": "wrapped",
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": true,
    "agent_review": true,
    "code_actions": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_branch_name": false,
    "show_user_menu": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_menus": false,
    "button_layout": "platform_default",
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "disable_ai": false,
  "vim_mode": true,
  "base_keymap": "VSCode",
  // "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  // "ui_font_family": "Iosevka Nerd Font Mono",
  "ui_font_size": 15,
  // "ui_font_weight": 50,
  "buffer_font_weight": 400,
  "buffer_line_height": "standard",
  // "buffer_font_family": "JetBrains Mono NL",
  "ui_font_family": "CaskaydiaCove Nerd Font Mono",
  "buffer_font_size": 18,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_size": 18,
    "alternate_scroll": "on",
    "line_height": "standard",
    "blinking": "on",
    "copy_on_select": true,
    "cursor_shape": "block",
    "keep_selection_on_copy": false,
    "toolbar": {
      "breadcrumbs": false,
    },
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
      },
    },
  },
  "semantic_tokens": "combined",
  "languages": {
    "Go": {
      "semantic_tokens": "full",
    },
    "Dockerfile": {
      "format_on_save": "off",
    },
  },
  "experimental.theme_overrides": {
    "syntax": {
      "type": {
        "font_weight": 800,
      },
      "keyword": {
        "font_weight": 800,
      },
      "punctuation.bracket": {
        "font_weight": 100,
      },
    },
  },
  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml",
    ],
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ],
    "Terraform": ["**/*.nomad"],
  },
  "lsp": {
    "jsonnet-language-server": {
      "settings": {
        "resolve_paths_with_tanka": true,
      },
    },
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
    "ansible-language-server": {
      "settings": {
        "ansible": {
          "path": "ansible",
        },
        "executionEnvironment": {
          "enabled": false,
        },
        "python": {
          "interpreterPath": "python3",
        },
        "validation": {
          "enabled": true,
          // To enable linting, manually install ansible-lint and make sure it is your PATH
          "lint": {
            "enabled": true,
            "path": "ansible-lint",
          },
        },
      },
    },
    "python": {
      "enabled": false,
    },
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
      "completion": {
        "snippets": {
          "custom": {
            "Arc::new": {
              "postfix": "arc",
              "body": ["Arc::new(${receiver})"],
              "requires": "std::sync::Arc",
              "scope": "expr",
            },
            "Some": {
              "postfix": "some",
              "body": ["Some(${receiver})"],
              "scope": "expr",
            },
            "Ok": {
              "postfix": "ok",
              "body": ["Ok(${receiver})"],
              "scope": "expr",
            },
            "Rc::new": {
              "postfix": "rc",
              "body": ["Rc::new(${receiver})"],
              "requires": "std::rc::Rc",
              "scope": "expr",
            },
            "Box::pin": {
              "postfix": "boxpin",
              "body": ["Box::pin(${receiver})"],
              "requires": "std::boxed::Box",
              "scope": "expr",
            },
            "vec!": {
              "postfix": "vec",
              "body": ["vec![${receiver}]"],
              "description": "vec![]",
              "scope": "expr",
            },
          },
        },
      },
    },
  },
}
